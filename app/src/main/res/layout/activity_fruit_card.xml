<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cvFruit"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="30dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="5dp"
    app:cardCornerRadius="20dp"
    android:layout_marginHorizontal="20dp"
    android:backgroundTint="@color/cards">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"

        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="15sp"

            >
            <TextView
                android:id="@+id/txtFruitTypeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="5dp"
                android:maxHeight="60dp"
                android:text="Fruit Type - Fruit Name"
                android:textSize="20dp"
                android:textColor="@color/black"
                />
            <TextView
                android:id="@+id/txtFruitID"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:visibility="gone"
                />

            <TextView
                android:id="@+id/txtFruitQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="5dp"
                android:text="Fruit Quantity"
                android:textSize="16dp"
                android:textColor="@color/black"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                >
                <TextView
                    android:id="@+id/txtFruitRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="5sp"
                    android:layout_marginRight="-20sp"
                    android:text="Fruit Rating:"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    />
                <RatingBar
                    android:id="@+id/rbFruitRating"
                    android:layout_width="240sp"
                    android:layout_height="45sp"
                    android:scaleY="0.75"
                    android:scaleX="0.75"
                    android:numStars="5"
                    android:rating="3"
                    android:progressTint="@color/Yellow"
                    />

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>