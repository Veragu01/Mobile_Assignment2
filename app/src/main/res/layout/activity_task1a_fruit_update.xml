<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".task1.task1a.Task1a_FruitUpdate"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/background_green">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="24sp"
        android:text="Update Fruit"
        android:textStyle="bold"
        android:textSize="24sp"
        android:textColor="@color/black"
        />
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginVertical="5sp"
        app:cardCornerRadius="5sp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="10sp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="5sp"
                android:text="Fruit Name:"
                android:textColor="@color/black"
                android:textSize="16sp"
                />
            <EditText
                android:id="@+id/etUpdateFruitName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Braeburn"
                android:textColor="@color/black"
                android:textSize="18sp"
                />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginVertical="5sp"
        app:cardCornerRadius="5sp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="10sp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="5sp"
                android:text="Fruit Type:"
                android:textColor="@color/black"
                android:textSize="16sp"
                />
            <EditText
                android:id="@+id/etUpdateFruitType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Apple"
                android:textColor="@color/black"
                android:textSize="18sp"
                />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginVertical="5sp"
        app:cardCornerRadius="5sp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="10sp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="5sp"
                android:text="Quantity of Fruit:"
                android:textColor="@color/black"
                android:textSize="16sp"
                />
            <EditText
                android:id="@+id/etUpdateFruitQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. 12"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:inputType="number"
                />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginVertical="5sp"
        app:cardCornerRadius="5sp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="10sp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="5sp"
                android:text="Fruit Rating:"
                android:textColor="@color/black"
                android:textSize="16sp"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="10sp"
                ><RatingBar
                android:id="@+id/rbUpdateFruitRating"
                android:layout_width="240sp"
                android:layout_height="45sp"
                android:scaleY="1"
                android:scaleX="1"
                android:numStars="5"
                android:rating="0"
                android:progressTint="@color/Yellow"
                /></LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        />
    <Button
        android:id="@+id/btnUpdateFruit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:text="Update Fruit"
        android:textSize="18sp"
        android:textColor="@color/white"
        />
    <Button
        android:id="@+id/btnDeleteFruit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:backgroundTint="@color/red"
        android:text="Delete Fruit"
        android:textSize="18sp"
        android:textColor="@color/white"
        />
    <Button
        android:id="@+id/btnCancelUpdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginBottom="16sp"
        android:backgroundTint="@color/grey"
        android:text="Cancel"
        android:textSize="18sp"
        android:textColor="@color/white"
        />




</LinearLayout>